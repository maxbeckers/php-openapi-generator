{%- macro renderLaravelNestedRules(prop, method, indent) -%}
{%- if prop.schema.ref is not null and not prop.isEnum -%}
{%- set nestedType = prop.phpType starts with '?' ? prop.phpType|slice(1) : prop.phpType -%}
{{ indent }}foreach ({{ nestedType }}::{{ method }}() as $nestedKey => $nestedRules) {
{{ indent }}    $rules[{{ prop.wireName|php_export }} . '.' . $nestedKey] = $nestedRules;
{{ indent }}}
{%- elseif prop.schema.type == 'array' and prop.schema.items is not null and prop.schema.items.ref is not null -%}
{%- set nestedType = prop.phpType|replace({'?': '', '[]': ''}) -%}
{{ indent }}foreach ({{ nestedType }}::{{ method }}() as $nestedKey => $nestedRules) {
{{ indent }}    $rules[{{ (prop.wireName ~ '.*.')|php_export }} . $nestedKey] = $nestedRules;
{{ indent }}}
{%- endif -%}
{%- endmacro -%}

{%- macro renderLaravelUniqueItemsRule(prop, indent) -%}
{%- if prop.schema.type == 'array' and prop.schema.uniqueItems -%}
{{ indent }}$rules[{{ (prop.wireName ~ '.*')|php_export }}] = ['distinct'];
{%- endif -%}
{%- endmacro -%}

{%- macro renderLaravelRuleEnrichments(properties, method, indent) -%}
{%- set lines = [] -%}
{%- for prop in properties -%}
{%- set includeProperty = not (method == 'requestRules' and prop.readOnly) and not (method == 'responseRules' and prop.writeOnly) -%}
{%- if includeProperty and prop.schema.ref is not null and not prop.isEnum -%}
{%- set lines = lines|merge([_self.renderLaravelNestedRules(prop, method, indent)|trim("\n\r")]) -%}
{%- elseif includeProperty and prop.schema.type == 'array' and prop.schema.items is not null and prop.schema.items.ref is not null -%}
{%- set lines = lines|merge([_self.renderLaravelNestedRules(prop, method, indent)|trim("\n\r")]) -%}
{%- endif -%}
{%- if includeProperty and prop.schema.type == 'array' and prop.schema.uniqueItems -%}
{%- set lines = lines|merge([_self.renderLaravelUniqueItemsRule(prop, indent)|trim("\n\r")]) -%}
{%- endif -%}
{%- endfor -%}
{{ lines|join("\n") }}
{%- endmacro -%}

{%- macro renderLaravelValidationRules(config, prop, direction = 'all') -%}
{% if config.validationStrategy.name == 'LaravelValidation' and prop.schema is not null %}
{% if not ((direction == 'request' and prop.readOnly) or (direction == 'response' and prop.writeOnly)) %}
{% set isStringType = prop.schema.type == 'string' %}
