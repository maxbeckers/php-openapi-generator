{% macro renderNativePayloadMethod(indent, includePayload, includeRequest, includeResponse) %}
{% if includePayload %}
{{ indent }}private function validateNativePayload(mixed $value): void
{{ indent }}{
{{ indent }}    if (is_array($value)) {
{{ indent }}        foreach ($value as $item) {
{{ indent }}            $this->validateNativePayload($item);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    if (is_object($value) && method_exists($value, 'validateOrThrow')) {
{{ indent }}        $value->validateOrThrow();
{{ indent }}    }
{{ indent }}}

{% endif %}
{% if includeRequest %}
{{ indent }}private function validateNativeRequestPayload(mixed $value): void
{{ indent }}{
{{ indent }}    if (is_array($value)) {
{{ indent }}        foreach ($value as $item) {
{{ indent }}            $this->validateNativeRequestPayload($item);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    if (is_object($value)) {
{{ indent }}        if (method_exists($value, 'validateOrThrowForRequest')) {
{{ indent }}            $value->validateOrThrowForRequest();

{{ indent }}            return;
{{ indent }}        }

{{ indent }}        if (method_exists($value, 'validateOrThrow')) {
{{ indent }}            $value->validateOrThrow();
{{ indent }}        }
{{ indent }}    }
{{ indent }}}

{% endif %}
{% if includeResponse %}
{{ indent }}private function validateNativeResponsePayload(mixed $value): void
{{ indent }}{
{{ indent }}    if (is_array($value)) {
{{ indent }}        foreach ($value as $item) {
{{ indent }}            $this->validateNativeResponsePayload($item);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    if (is_object($value)) {
{{ indent }}        if (method_exists($value, 'validateOrThrowForResponse')) {
{{ indent }}            $value->validateOrThrowForResponse();

{{ indent }}            return;
{{ indent }}        }

{{ indent }}        if (method_exists($value, 'validateOrThrow')) {
{{ indent }}            $value->validateOrThrow();
{{ indent }}        }
{{ indent }}    }
{{ indent }}}
{% endif %}
{% endmacro %}

{% macro renderSymfonyPayloadMethod(indent, includePayload, includeRequest, includeResponse) %}
{% if includePayload %}
{{ indent }}/**
{{ indent }} * @param \SplObjectStorage<object, mixed>|null $visited
{{ indent }} */
{{ indent }}private function validateSymfonyPayload(mixed $value, ?\SplObjectStorage $visited = null): void
{{ indent }}{
{{ indent }}    if (!is_array($value) && !is_object($value)) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $visited ??= new \SplObjectStorage();

{{ indent }}    if (is_object($value)) {
{{ indent }}        if ($visited->contains($value)) {
{{ indent }}            return;
{{ indent }}        }
{{ indent }}        $visited->attach($value);

{{ indent }}        $violations = $this->validator->validate($value);
{{ indent }}        if (count($violations) > 0) {
{{ indent }}            throw new \InvalidArgumentException((string) $violations);
{{ indent }}        }

{{ indent }}        foreach (get_object_vars($value) as $propertyValue) {
{{ indent }}            $this->validateSymfonyPayload($propertyValue, $visited);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    foreach ($value as $item) {
{{ indent }}        $this->validateSymfonyPayload($item, $visited);
{{ indent }}    }
{{ indent }}}

{% endif %}
{% if includeRequest %}
{{ indent }}/**
{{ indent }} * @param \SplObjectStorage<object, mixed>|null $visited
{{ indent }} */
{{ indent }}private function validateSymfonyRequestPayload(mixed $value, ?\SplObjectStorage $visited = null): void
{{ indent }}{
{{ indent }}    if (!is_array($value) && !is_object($value)) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $visited ??= new \SplObjectStorage();

{{ indent }}    if (is_object($value)) {
{{ indent }}        if ($visited->contains($value)) {
{{ indent }}            return;
{{ indent }}        }
{{ indent }}        $visited->attach($value);

{{ indent }}        $violations = $this->validator->validate($value, groups: ['request']);
{{ indent }}        if (count($violations) > 0) {
{{ indent }}            throw new \InvalidArgumentException((string) $violations);
{{ indent }}        }

{{ indent }}        foreach (get_object_vars($value) as $propertyValue) {
{{ indent }}            $this->validateSymfonyRequestPayload($propertyValue, $visited);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    foreach ($value as $item) {
{{ indent }}        $this->validateSymfonyRequestPayload($item, $visited);
{{ indent }}    }
{{ indent }}}

{% endif %}
{% if includeResponse %}
{{ indent }}/**
{{ indent }} * @param \SplObjectStorage<object, mixed>|null $visited
{{ indent }} */
{{ indent }}private function validateSymfonyResponsePayload(mixed $value, ?\SplObjectStorage $visited = null): void
{{ indent }}{
{{ indent }}    if (!is_array($value) && !is_object($value)) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $visited ??= new \SplObjectStorage();

{{ indent }}    if (is_object($value)) {
{{ indent }}        if ($visited->contains($value)) {
{{ indent }}            return;
{{ indent }}        }
{{ indent }}        $visited->attach($value);

{{ indent }}        $violations = $this->validator->validate($value, groups: ['response']);
{{ indent }}        if (count($violations) > 0) {
{{ indent }}            throw new \InvalidArgumentException((string) $violations);
{{ indent }}        }

{{ indent }}        foreach (get_object_vars($value) as $propertyValue) {
{{ indent }}            $this->validateSymfonyResponsePayload($propertyValue, $visited);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    foreach ($value as $item) {
{{ indent }}        $this->validateSymfonyResponsePayload($item, $visited);
{{ indent }}    }
{{ indent }}}
{% endif %}
{% endmacro %}

{% macro renderLaravelPayloadMethod(indent, includeRequest, includeResponse) %}
{% if includeRequest %}
{{ indent }}private function validateLaravelRequestPayload(mixed $value): void
{{ indent }}{
{{ indent }}    if (is_array($value)) {
{{ indent }}        foreach ($value as $item) {
{{ indent }}            $this->validateLaravelRequestPayload($item);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    if (!is_object($value)) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $class = $value::class;
{{ indent }}    if (!method_exists($class, 'requestRules')) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $validator = \Illuminate\Support\Facades\Validator::make(
{{ indent }}        method_exists($value, 'toRequestArray')
{{ indent }}            ? $value->toRequestArray()
{{ indent }}            : (method_exists($value, 'toArray') ? $value->toArray() : get_object_vars($value)),
{{ indent }}        $class::requestRules(),
{{ indent }}    );

{{ indent }}    if ($validator->fails()) {
{{ indent }}        throw new \Illuminate\Validation\ValidationException($validator);
{{ indent }}    }

{{ indent }}    foreach (get_object_vars($value) as $propertyValue) {
{{ indent }}        $this->validateLaravelRequestPayload($propertyValue);
{{ indent }}    }
{{ indent }}}

{% endif %}
{% if includeResponse %}
{{ indent }}private function validateLaravelResponsePayload(mixed $value): void
{{ indent }}{
{{ indent }}    if (is_array($value)) {
{{ indent }}        foreach ($value as $item) {
{{ indent }}            $this->validateLaravelResponsePayload($item);
{{ indent }}        }

{{ indent }}        return;
{{ indent }}    }

{{ indent }}    if (!is_object($value)) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $class = $value::class;
{{ indent }}    if (!method_exists($class, 'responseRules')) {
{{ indent }}        return;
{{ indent }}    }

{{ indent }}    $validator = \Illuminate\Support\Facades\Validator::make(
{{ indent }}        method_exists($value, 'toResponseArray')
{{ indent }}            ? $value->toResponseArray()
{{ indent }}            : (method_exists($value, 'toArray') ? $value->toArray() : get_object_vars($value)),
{{ indent }}        $class::responseRules(),
{{ indent }}    );

{{ indent }}    if ($validator->fails()) {
{{ indent }}        throw new \InvalidArgumentException('Validation failed: ' . $validator->errors());
{{ indent }}    }

{{ indent }}    foreach (get_object_vars($value) as $propertyValue) {
{{ indent }}        $this->validateLaravelResponsePayload($propertyValue);
{{ indent }}    }
{{ indent }}}
{% endif %}
{% endmacro %}
