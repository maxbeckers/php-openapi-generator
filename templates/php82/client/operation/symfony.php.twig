        $response = $this->httpClient->request(
            '{{ op.httpMethod|upper }}',
            $url,
{% if hasHeaders or op.requestBodyType is not null %}
            [
{% if hasHeaders %}
                'headers' => $headers,
{% endif %}
{% if op.requestBodyType is not null %}
                'json' => $body{% if not op.requestBodyRequired %}?{% endif %}->toRequestArray(),
{% endif %}
            ],
{% endif %}
        );
{% set responseContentType = "$response->getHeaders(false)['content-type'][0] ?? ''" %}
{% set responseBody = '$response->getContent(false)' %}
