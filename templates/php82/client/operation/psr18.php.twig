        $request = $this->requestFactory->createRequest('{{ op.httpMethod|upper }}', $url);
{% if hasHeaders %}
        foreach ($headers as $name => $value) {
            $request = $request->withHeader($name, $value);
        }
{% endif %}
{% if op.requestBodyType is not null and op.requestBodyRequired %}
        $bodyStream = $this->streamFactory->createStream(json_encode($body->toRequestArray(), JSON_THROW_ON_ERROR));
        $request = $request->withHeader('Content-Type', 'application/json')->withBody($bodyStream);
{% elseif op.requestBodyType is not null %}
        if ($body !== null) {
            $bodyStream = $this->streamFactory->createStream(json_encode($body->toRequestArray(), JSON_THROW_ON_ERROR));
            $request = $request->withHeader('Content-Type', 'application/json')->withBody($bodyStream);
        }
{% endif %}
        $response = $this->httpClient->sendRequest($request);
{% set responseContentType = "$response->getHeaderLine('Content-Type')" %}
{% set responseBody = '(string) $response->getBody()' %}
{% include 'client/operation/response.php.twig' %}
