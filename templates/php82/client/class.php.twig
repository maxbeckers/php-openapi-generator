{% for p in op.headerParams %}
{% if p.isArray() %}
{% set serialized = "implode(',', array_map(fn($value) => $this->serializeParameterValue($value), $" ~ p.name ~ "))" %}
{% else %}
{% set serialized = "$this->serializeParameterValue(" ~ p.wireValueExpression(false) ~ ")" %}
{% endif %}
{% if p.required %}
            '{{ p.wireName }}' => {{ serialized }},
{% else %}
