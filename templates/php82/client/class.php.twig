{% set hasSecurityCookies = isSecured and 'apiKey:cookie' in opSecurityKinds %}
{% set hasCookies = op.cookieParams is not empty or hasSecurityCookies %}
{% set hasHeaders = op.headerParams is not empty or hasCookies or isSecured %}
{% if op.headerParams is not empty %}
