    private function serializeParameterValue(mixed $value): string
    {
        if ($value instanceof \BackedEnum) {
            $value = $value->value;
        }

        if (is_bool($value)) {
            return $value ? 'true' : 'false';
        }

        if ($value instanceof \DateTimeInterface) {
            return $value->format(\DateTimeInterface::ATOM);
        }

        if (!is_scalar($value)) {
            throw new \InvalidArgumentException(sprintf(
                'HTTP parameter values must be scalar; %s given.',
                get_debug_type($value),
            ));
        }

        return (string) $value;
    }

{% endif %}
{% if hasQueryParameters %}
    /**
     * Serializes query parameters according to their OpenAPI style and explode settings.
     *
     * @param list<array{string, mixed, string, bool}> $parameters
     */
    private function buildQueryString(array $parameters): string
    {
        $pairs = [];
        foreach ($parameters as [$name, $value, $style, $explode]) {
            if ($value === null) {
                continue;
            }

            $encodedName = rawurlencode($name);
            if (!is_array($value)) {
                $pairs[] = $encodedName . '=' . rawurlencode($this->serializeParameterValue($value));

                continue;
            }

            if ($style === 'deepObject') {
                foreach ($value as $key => $item) {
                    $pairs[] = $encodedName . '[' . rawurlencode((string) $key) . ']='
                        . rawurlencode($this->serializeParameterValue($item));
                }

                continue;
            }

            $items = array_map(
                fn(mixed $item): string => rawurlencode($this->serializeParameterValue($item)),
                array_values($value),
            );
            if ($style === 'form' && $explode) {
                foreach ($items as $item) {
                    $pairs[] = $encodedName . '=' . $item;
                }

                continue;
            }

            if ($items === []) {
                continue;
            }

            $delimiter = match ($style) {
                'spaceDelimited' => '%20',
                'pipeDelimited' => '%7C',
                default => ',',
            };
            $pairs[] = $encodedName . '=' . implode($delimiter, $items);
        }

        return implode('&', $pairs);
    }

{% endif %}
{% if config.typedErrorResponses %}
    private function decodeErrorPayload(string $contentType, string $body): mixed
    {
        if ($body === '' || ($contentType !== '' && !str_contains(strtolower($contentType), 'json'))) {
            return null;
        }

        try {
            return json_decode($body, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException) {
            return null;
        }
    }

    private function createApiException(int $statusCode, string $operationId, string $responseBody, mixed $payload): ApiException
    {
        $message = sprintf('API operation "%s" failed with HTTP status %d.', $operationId, $statusCode);
{% set groupErrorClasses = {} %}
{% for op in group.operations %}
{% for code, exceptionClass in op.errorExceptionClasses() %}
{% set groupErrorClasses = groupErrorClasses|merge({('s' ~ code): {code: code, name: exceptionClass}}) %}
{% endfor %}
{% endfor %}
{% if groupErrorClasses is empty %}

        return new ApiException($message, $statusCode, $operationId, $responseBody, $payload);
{% else %}

        return match ($statusCode) {
{% for entry in groupErrorClasses|sort((a, b) => a.code <=> b.code) %}
            {{ entry.code }} => new {{ entry.name }}($message, $statusCode, $operationId, $responseBody, $payload),
{% endfor %}
            default => new ApiException($message, $statusCode, $operationId, $responseBody, $payload),
        };
{% endif %}
    }
{% else %}
    private function assertSuccessfulStatus(int $statusCode, string $operationId): void
    {
        if ($statusCode < 200 || $statusCode >= 300) {
            throw new \RuntimeException(sprintf(
                'API operation "%s" failed with HTTP status %d.',
                $operationId,
                $statusCode,
            ));
        }
    }
{% endif %}
{% if group.securitySchemes is not empty %}

    /**
     * Picks the first security requirement alternative whose credentials are configured.
     *
     * @param list<list<string>> $alternatives
     *
     * @return array{headers: array<string, string>, query: list<array{string, string, string, bool}>, cookies: list<string>}
     */
    private function resolveSecurity(array $alternatives): array
    {
        $security = ['headers' => [], 'query' => [], 'cookies' => []];
        $credentials = $this->credentials;
        if ($credentials === null) {
            return $security;
        }

        foreach ($alternatives as $schemes) {
            $candidate = $security;
            foreach ($schemes as $scheme) {
{% for scheme in group.securitySchemes %}
                {% if not loop.first %}} else{% endif %}if ($scheme === '{{ scheme.name }}') {
{% if scheme.kind == 'basic' %}
                    if ($credentials->{{ scheme.propertyName }}Username === null || $credentials->{{ scheme.propertyName }}Password === null) {
                        continue 2;
                    }
                    $candidate['headers']['Authorization'] = 'Basic ' . base64_encode(
                        $credentials->{{ scheme.propertyName }}Username . ':' . $credentials->{{ scheme.propertyName }}Password,
                    );
{% elseif scheme.kind == 'apiKey' %}
                    if ($credentials->{{ scheme.propertyName }} === null) {
                        continue 2;
                    }
{% if scheme.in == 'query' %}
                    $candidate['query'][] = ['{{ scheme.parameterName }}', $credentials->{{ scheme.propertyName }}, 'form', true];
{% elseif scheme.in == 'cookie' %}
                    $candidate['cookies'][] = '{{ scheme.parameterName }}=' . rawurlencode($credentials->{{ scheme.propertyName }});
{% else %}
                    $candidate['headers']['{{ scheme.parameterName }}'] = $credentials->{{ scheme.propertyName }};
{% endif %}
{% else %}
                    if ($credentials->{{ scheme.propertyName }}Token === null) {
                        continue 2;
                    }
                    $candidate['headers']['Authorization'] = '{{ scheme.kind == 'bearer' ? 'Bearer' : scheme.httpScheme }} ' . $credentials->{{ scheme.propertyName }}Token;
{% endif %}
{% endfor %}
                } else {
                    continue 2;
                }
            }

            return $candidate;
        }

        return $security;
    }
{% endif %}

{% if hasResponsePayloads %}
    private function decodeJsonResponse(string $contentType, string $body, string $operationId): mixed
    {
        if ($contentType !== '' && !str_contains(strtolower($contentType), 'json')) {
            throw new \UnexpectedValueException(sprintf(
                'Expected a JSON response for operation "%s", got content type "%s".',
                $operationId,
                $contentType,
            ));
        }

        try {
            return json_decode($body, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException $exception) {
            throw new \UnexpectedValueException(sprintf(
                'Invalid JSON response for operation "%s": %s',
                $operationId,
                $exception->getMessage(),
            ), 0, $exception);
        }
    }

{% endif %}
