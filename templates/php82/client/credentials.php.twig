{% import 'shared/generation-meta-macros.php.twig' as generation %}
<?php

declare(strict_types=1);

namespace {{ namespace }};

{{ generation.renderFileHeader(generationMeta, '') }}

/**
 * Credentials for the security schemes declared by the API.
 *
 * Leave a value null to skip the scheme; operations use the first security requirement whose credentials are all set.
 */
final class ApiCredentials
{
    public function __construct(
{% for scheme in schemes %}
{% if scheme.kind == 'basic' %}
        public readonly ?string ${{ scheme.propertyName }}Username = null,
        public readonly ?string ${{ scheme.propertyName }}Password = null,
{% elseif scheme.kind == 'apiKey' %}
        public readonly ?string ${{ scheme.propertyName }} = null,
{% else %}
        public readonly ?string ${{ scheme.propertyName }}Token = null,
{% endif %}
{% endfor %}
    ) {}
}
